
import 'package:flutter/material.dart';

void main() {
  runApp(MyApp());
}

class MyApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      home: Scaffold(
        appBar: AppBar(
          title: Text('Student Information'),
          backgroundColor: Colors.blue,
        ),
        backgroundColor: Colors.blue.shade50,
        body: Center(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              StudentCard(
                name: 'Vinay',
                branch: 'CSE',
                cgpa: '9.45',
                icon: Icons.person,
              ),

              StudentCard(
                name: 'Rahul',
                branch: 'ECE',
                cgpa: '9.0',
                icon: Icons.school,
              ),

              StudentCard(
                name: 'Suresh',
                branch: 'IT',
                cgpa: '8.8',
                icon: Icons.face,
